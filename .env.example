# Reddit API (https://www.reddit.com/prefs/apps → create app → script)
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=TrendTracker/1.0 by YourUsername

# YouTube Data API v3 (https://console.cloud.google.com → APIs → YouTube Data API v3)
YOUTUBE_API_KEY=your_youtube_api_key

# Alert thresholds
REDDIT_UPVOTE_THRESHOLD=50
REDDIT_COMMENT_THRESHOLD=20
YOUTUBE_VIEW_THRESHOLD=1000
YOUTUBE_LIKE_THRESHOLD=50

# Poll interval in minutes (default: 30)
POLL_INTERVAL_MINUTES=30
